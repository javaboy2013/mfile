{
  "name": "mfile",
  "version": "0.2.0",
  "private": true,
  "description": "mfile — macOS 文件管理器（Electron）",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test electron/test/*.test.js",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e",
    "dist": "electron-builder --mac",
    "deploy": "electron-builder --mac && rm -rf /Applications/mfile.app && cp -R dist/mac-arm64/mfile.app /Applications/ && echo '✓ 已安装到 /Applications/mfile.app'"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "electron-updater": "^6.8.3"
  }
}
