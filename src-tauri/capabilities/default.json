{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "mfile 主窗口默认权限",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "**" }]
    },
    {
      "identifier": "opener:allow-reveal-item-in-dir",
      "allow": [{ "path": "**" }]
    },
    "updater:default",
    "process:allow-restart"
  ]
}
