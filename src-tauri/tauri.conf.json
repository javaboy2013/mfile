{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mfile",
  "version": "0.1.2",
  "identifier": "com.vincent.mfile",
  "build": {
    "beforeDevCommand": "npm run dev:ui",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "mfile",
        "width": 1100,
        "height": 700,
        "minWidth": 720,
        "minHeight": 480,
        "backgroundColor": "#364054"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
