{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mfile",
  "version": "0.1.2",
  "identifier": "com.vincent.mfile",
  "build": {
    "beforeDevCommand": "npm run dev:ui",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:ui",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "mfile",
        "width": 1100,
        "height": 700,
        "minWidth": 720,
        "minHeight": 480,
        "center": true,
        "backgroundColor": "#1e1e20"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU4RDMyRkY4QzUwQzdGM0IKUldRN2Z3ekYrQy9UNksyaUJnWUN0aUtlLzJvdDh2ZDMrRjlqdUhjSmlnZzdMdllMbS85TkNCWWYK",
      "endpoints": [
        "https://github.com/javaboy2013/mfile/releases/latest/download/latest.json"
      ]
    }
  }
}
